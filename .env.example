# Vorlage fuer .env.local - keine echten Werte in diese Datei eintragen.

# Basis-URL fuer canonical URLs, Sitemap und Open Graph
NEXT_PUBLIC_SITE_URL=https://www.felgenhotel.de

# Cloudflare Turnstile
# Der Site-Key ist oeffentlich, der Secret-Key wird ausschliesslich serverseitig verwendet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (Versand der Reparaturanfragen)
RESEND_API_KEY=
CONTACT_MAIL_TO=info@felgenhotel.de
CONTACT_MAIL_FROM=
